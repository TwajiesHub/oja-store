# Names only. Copy to .env and fill in values locally. Never commit .env.
# Anything starting with VITE_ is shipped to every visitor's browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Leave empty locally to use sqlite:///./oja.db
DATABASE_URL=
# Session pooler (port 5432). Only used by: python -m scripts.init_db --supabase
DATABASE_URL_SESSION=

PAYSTACK_SECRET_KEY=

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=
MAILGUN_FROM=

# Production only. Locally http://localhost:5173
APP_URL=

# Public. Shown on the privacy and terms pages for deletion and return requests.
VITE_CONTACT_EMAIL=
